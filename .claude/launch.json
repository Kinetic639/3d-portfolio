        "3001"
      ],
      "port": 3001
    },
    {
      "name": "nomadic-tribe",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "D:/dev/nomadic-tribe",
        "run",
        "dev",
        "--",
        "--port",
        "3100"
      ],
      "port": 3100
    }
