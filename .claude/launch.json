{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "new-portfolio",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "new-portfolio",
        "run",
        "dev"
      ],
      "port": 3000
